<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{DOCUMENT_ROOT}/install/index.php -f
    RewriteCond %{REQUEST_URI} !^/install/
    RewriteRule ^ - [F,L]
</IfModule>

<Files "*.txt">
    Require all denied
</Files>
<Files "error_log">
    Require all denied
</Files>
<Files "*.sh">
    Require all denied
</Files>
<Files "composer.lock">
    Require all denied
</Files>
<IfModule mod_alias.c>
    RedirectMatch 404 /\.git
</IfModule>
<Files "*.json">
    Require all denied
</Files>
<Files "*.sql">
    Require all denied
</Files>
<Files "*.zip">
    Require all denied
</Files>

Options -Indexes

<FilesMatch "^error_log$|\.log$|\.log\.[0-9]+$">
    Require all denied
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "^(config\.php|security\.php|api_token\.php)$">
    Require all denied
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
